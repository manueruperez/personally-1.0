# ============================================================
# Personally MVP - variables de entorno
# Copia este archivo a .env y rellena los valores.
# NUNCA commitees .env (ya esta en .gitignore).
# ============================================================

# ─── Runtime ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ─── API (apps/api) ─────────────────────────────────────────
API_PORT=3000
API_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173

# ─── Supabase (bloqueante) ──────────────────────────────────
# Obtienes estos valores en Supabase → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Supabase → Settings → Database → Connection string
DATABASE_URL=
DIRECT_URL=

# ─── Agent (apps/agent) ─────────────────────────────────────
# Token interno compartido entre agent y api para rutas /internal
AGENT_TOKEN=change-me-to-a-long-random-string
# Numero de telefono dedicado para el bot (no el personal)
WHATSAPP_NUMBER=

# ─── WhatsApp Cloud API (obligatorias: sin ellas el agente no arranca) ─────────────
# Se obtienen en developers.facebook.com tras crear la app Business.
# Ver planes-dev/2026-08-05-migracion-whatsapp-cloud-api/README.md §2.
WHATSAPP_PHONE_NUMBER_ID=
# Token permanente de System User (los del panel duran 24h y no sirven en prod)
WHATSAPP_ACCESS_TOKEN=
# Idioma de las plantillas registradas en Meta (default: es)
WHATSAPP_TEMPLATE_LANGUAGE=es
# Secreto de la app, para validar la firma X-Hub-Signature-256 del webhook
WHATSAPP_APP_SECRET=
# String arbitrario que vos elegis; Meta lo repite al dar de alta el webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ─── Scheduler (apps/scheduler) ─────────────────────────────
SCHEDULER_TIMEZONE=America/Bogota

# ─── Frontend (apps/frontend) ───────────────────────────────
VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── OpenAI (opcional, solo para traducir catalogo) ─────────
OPENAI_API_KEY=

# ─── Bootstrap del primer trainer (one-shot) ────────────────
# Solo se usa al correr `pnpm bootstrap:trainer`.
# Una vez creado tu usuario, podes borrar o dejar vacios estos valores.
BOOTSTRAP_EMAIL=
BOOTSTRAP_NAME=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_ORG_NAME=

# ─── Testing (opcional, solo dev) ───────────────────────────
# TESTING_DOW=1..7 → fuerza el dia-de-semana usado por el dispatcher
# (1=lunes, 7=domingo). Util para probar dias multi-item sin esperar.
TESTING_DOW=
