# ============================================================
# Deploy de Personally — copiar a deploy/.env y rellenar.
# NUNCA commitear deploy/.env (cubierto por .gitignore raíz).
#
# Secretos: generarlos con
#   node deploy/scripts/generate-keys.mjs >> deploy/.env
# ============================================================

# Dominio público del stack (A record apuntando a la IP del VPS)
DOMAIN=demo.tudominio.com

TZ=America/Bogota

# ─── Generados por generate-keys.mjs ────────────────────────
POSTGRES_PASSWORD=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AGENT_TOKEN=

# ─── Post-bootstrap ─────────────────────────────────────────
# UUID del trainer dueño del número de WhatsApp.
# Lo imprime el bootstrap (paso 6 del README). Rellenar y `docker compose up -d agent`.
AGENT_TRAINER_ID=
