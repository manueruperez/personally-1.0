{
  "name": "personally-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Personally 1.0 - asistente de ejecucion de planes de entrenamiento por WhatsApp",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules",
    "db:generate": "pnpm --filter @personally/db generate",
    "db:migrate": "pnpm --filter @personally/db migrate",
    "db:push": "pnpm --filter @personally/db push",
    "db:studio": "pnpm --filter @personally/db studio",
    "db:seed": "pnpm --filter @personally/db seed",
    "bootstrap:trainer": "pnpm --filter @personally/db bootstrap:trainer",
    "load:exercises": "pnpm --filter @personally/db load:exercises",
    "api:dev": "pnpm --filter @personally/api dev",
    "agent:dev": "pnpm --filter @personally/agent dev",
    "agent:supervised": "pnpm --filter @personally/agent supervised",
    "scheduler:dev": "pnpm --filter @personally/scheduler dev",
    "frontend:dev": "pnpm --filter @personally/frontend dev"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@vitest/coverage-v8": "^1.6.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
